{
  "name": "our-memory-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:api": "node --env-file=.env.test --test tests/service/*.test.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:local-auth": "node --env-file=.env.test scripts/setup-local-auth.mjs",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json next.config.ts playwright.config.ts postcss.config.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@aws-sdk/s3-request-presigner": "3.1159.0",
    "@neondatabase/auth": "0.7.0-beta",
    "@puckeditor/core": "0.23.0",
    "better-auth": "1.7.14",
    "next": "16.4.3",
    "pg": "8.23.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.10",
    "s3rver": "3.7.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "better-auth": "$better-auth",
    "zod": "4.6.7",
    "happy-dom": "21.0.4"
  },
  "engines": {
    "node": "24.x"
  }
}
